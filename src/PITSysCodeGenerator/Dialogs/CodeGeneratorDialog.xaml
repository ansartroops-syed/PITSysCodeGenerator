<Window x:Class="PITSysCodeGenerator.Dialogs.CodeGeneratorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIT SysOperation Code Generator"
        Width="700" Height="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PIT SysOperation Code Generator for D365FO"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Prefix:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPrefix" Text="PIT"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="Class Name:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtClassName" Text="SampleBatchJob"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Caption:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" x:Name="txtCaption" Text="Sample Batch Job" Margin="0,5,0,0"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Output:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtOutput" Margin="0,5,0,0"/>
            <Button Grid.Row="2" Grid.Column="4" Content="Browse..." Click="Browse_Click" Margin="0,5,0,0" HorizontalAlignment="Left" Padding="10,3"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Generate Classes" Margin="0,0,0,10">
            <WrapPanel Margin="5">
                <CheckBox x:Name="chkContract" Content="Contract" IsChecked="True" Margin="0,0,15,5"/>
                <CheckBox x:Name="chkService" Content="Service" IsChecked="True" Margin="0,0,15,5"/>
                <CheckBox x:Name="chkController" Content="Controller" IsChecked="True" Margin="0,0,15,5"/>
                <CheckBox x:Name="chkDP" Content="DataProvider" Margin="0,0,15,5"/>
                <CheckBox x:Name="chkUI" Content="UIBuilder" Margin="0,0,15,5"/>
                <CheckBox x:Name="chkMenu" Content="MenuItem" Margin="0,0,15,5"/>
            </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Contract Fields">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtFieldName" Width="120" Margin="0,0,10,0"/>
                    <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtFieldType" Width="120" Margin="0,0,10,0"/>
                    <TextBlock Text="Label:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtFieldLabel" Width="120" Margin="0,0,10,0"/>
                    <Button Content="Add" Click="AddField_Click" Padding="10,3"/>
                    <Button Content="Remove" Click="RemoveField_Click" Padding="10,3" Margin="5,0,0,0"/>
                </StackPanel>
                <ListBox Grid.Row="1" x:Name="lstFields" DisplayMemberPath="FieldName"/>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="4" x:Name="txtStatus" Text="Ready" Foreground="Green" Margin="0,5,0,5"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Generate All" Click="Generate_Click" Padding="15,5" Margin="0,0,10,0" FontWeight="Bold"/>
            <Button Content="Close" Click="Close_Click" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Window>
