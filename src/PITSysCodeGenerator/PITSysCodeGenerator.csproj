<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================ -->
  <!-- CRITICAL: VSToolsPath must be defined BEFORE the first Import -->
  <!-- ============================================================ -->
  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>

  <!-- This import MUST come after VSToolsPath is defined -->
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>PITSysCodeGenerator</RootNamespace>
    <AssemblyName>PITSysCodeGenerator</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>

    <!-- ============================================================ -->
    <!-- CRITICAL: ProjectTypeGuids tells VS this is a VSIX project   -->
    <!-- {82b43b9b...} = VSIX Project Type                            -->
    <!-- {FAE04EC0...} = C# Project Type                              -->
    <!-- ============================================================ -->
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Framework References -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.5.4074">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- VSIX Manifest -->
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <!-- VSCT Command Table -->
  <ItemGroup>
    <VSCTCompile Include="Commands\PITSysCodeGeneratorCommandSet.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- C# Source Files -->
  <ItemGroup>
    <Compile Include="PITSysCodeGeneratorPackage.cs" />
    <Compile Include="Commands\GenerateCodeCommand.cs" />
    <Compile Include="Commands\CommandIds.cs" />
    <Compile Include="Dialogs\CodeGeneratorDialog.xaml.cs">
      <DependentUpon>CodeGeneratorDialog.xaml</DependentUpon>
    </Compile>
    <Compile Include="Dialogs\GeneratorViewModel.cs" />
    <Compile Include="Generators\ICodeGenerator.cs" />
    <Compile Include="Generators\ContractGenerator.cs" />
    <Compile Include="Generators\ServiceGenerator.cs" />
    <Compile Include="Generators\ControllerGenerator.cs" />
    <Compile Include="Generators\DataProviderGenerator.cs" />
    <Compile Include="Generators\UIBuilderGenerator.cs" />
    <Compile Include="Generators\MenuItemGenerator.cs" />
    <Compile Include="Models\GeneratorOptions.cs" />
    <Compile Include="Models\ContractField.cs" />
    <Compile Include="Models\SysOperationType.cs" />
    <Compile Include="Templates\ContractTemplate.cs" />
    <Compile Include="Templates\ServiceTemplate.cs" />
    <Compile Include="Templates\ControllerTemplate.cs" />
    <Compile Include="Templates\DataProviderTemplate.cs" />
    <Compile Include="Templates\UIBuilderTemplate.cs" />
    <Compile Include="Templates\MenuItemTemplate.cs" />
    <Compile Include="Helpers\D365NamingHelper.cs" />
    <Compile Include="Helpers\CodeFormatter.cs" />
    <Compile Include="Helpers\FileOutputHelper.cs" />
  </ItemGroup>

  <!-- XAML Pages -->
  <ItemGroup>
    <Page Include="Dialogs\CodeGeneratorDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!-- Resources -->
  <ItemGroup>
    <Content Include="Resources\PITIcon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\PITPreview.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Resources\Resources.resx" />
  </ItemGroup>
  <ItemGroup>
    <!-- License file must be packaged for Marketplace -->
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Build Targets -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- ============================================================ -->
  <!-- CRITICAL: VSSDK targets - only imported if VSToolsPath exists -->
  <!-- ============================================================ -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != '' AND Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

</Project>